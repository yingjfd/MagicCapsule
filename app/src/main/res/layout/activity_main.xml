<?xml version="1.0" encoding="utf-8"?>
<!--
  纯 framework 布局：不依赖 AppCompat / Material。
  设置页只做一件事：开关「胶囊不收起」。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_desc"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/section_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_switch"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_keep_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/switch_keep_expanded"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/switch_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_keep_expanded_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/section_howto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_howto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/howto_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/howto_body"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tip_scope"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
